<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>YiShuHelper.Service</AssemblyName>
    <RootNamespace>YiShuHelper.ServiceHost</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../YiShuHelper.Core/YiShuHelper.Core.csproj" />
    <Reference Include="System.ServiceProcess.ServiceController">
      <HintPath>$(MSBuildSDKsPath)\..\runtimes\win\lib\net10.0\System.ServiceProcess.ServiceController.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
